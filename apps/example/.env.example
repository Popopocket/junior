# Gateway remains the default for completions and specialized AI operations.
AI_GATEWAY_API_KEY=
# Optional custom completion endpoint. Set URL, its own key, and metadata together.
# Keep private values in gitignored .env.local, never in this example or an image.
AI_COMPLETION_BASE_URL=
AI_COMPLETION_API_KEY=
AI_COMPLETION_API=
AI_COMPLETION_MODELS=
# Example metadata for text-only local tests; zero costs are test estimates,
# not provider prices. Replace all rates with operator-declared USD/million.
# AI_COMPLETION_BASE_URL=http://127.0.0.1:8317/v1
# AI_COMPLETION_API=chat-completions # Or responses; absent defaults to chat-completions
# AI_COMPLETION_MODELS={"gpt-6.1-sol":{"contextWindow":500000,"maxTokens":65536,"input":["text"],"reasoning":true,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0}}}
# For this text-only custom setup, set AI_VISION_MODEL= in private .env.local.
# Chat vision uses the selected completion endpoint; verify image support first.
# Select a model separately with AI_MODEL and the role overrides below.
AI_MODEL=
# Set 500000 with the custom metadata example to avoid a lower host ceiling.
AI_MODEL_CONTEXT_WINDOW_TOKENS=
AI_REASONING_LEVEL=
AI_FAST_MODEL=
AI_HANDOFF_MODEL=
AI_GUARDIAN_MODEL=
# Profile reasoning overrides AI_REASONING_LEVEL; see local agent validation.
AI_MODEL_PROFILES=
AI_EMBEDDING_MODEL=
# AI_VISION_MODEL=openai/gpt-5.6-sol # Default when absent; set empty to disable vision
AI_WEB_SEARCH_MODEL=
AI_IMAGE_MODEL=
AGENT_TURN_TIMEOUT_MS=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_ORG=
SENTRY_ORG_SLUG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
